# URL of your PocketBase instance.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Copy this file to .env and set it to wherever PocketBase runs, e.g.:
#   http://localhost:8090            (same machine)
#   http://192.168.1.50:8090         (another PC on your LAN)
VITE_POCKETBASE_URL=http://127.0.0.1:8090